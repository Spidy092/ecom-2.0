{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "BhaivaTech Storefront Core validation",
    "author": "BhaivaTech",
    "description": "Disposable WordPress Playground environment for the Modern Grocery alpha."
  },
  "preferredVersions": {
    "php": "8.3",
    "wp": "7.1"
  },
  "landingPage": "/",
  "extraLibraries": [
    "wp-cli"
  ],
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "url",
        "url": "https://downloads.wordpress.org/plugin/woocommerce.11.0.1.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "defineWpConfigConsts",
      "consts": {
        "WP_DEBUG": true,
        "WP_DEBUG_LOG": true,
        "WP_DEBUG_DISPLAY": false,
        "SCRIPT_DEBUG": true,
        "WP_ENVIRONMENT_TYPE": "local"
      }
    },
    {
      "step": "activatePlugin",
      "pluginPath": "bhaivatech-storefront-core/storefront-core.php"
    },
    {
      "step": "activateTheme",
      "themeFolderName": "bhaivatech-grocery-alpha"
    },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "Modern Grocery",
        "blogdescription": "Fast everyday baskets, built on WooCommerce."
      }
    },
    {
      "step": "wp-cli",
      "command": "wp grovia seed-demo"
    },
    {
      "step": "runPHP",
      "code": "<?php\nrequire '/wordpress/wp-load.php';\n$zone = new WC_Shipping_Zone();\n$zone->set_zone_name( 'Bengaluru validation zone' );\n$zone->save();\nforeach ( array( '560001', '560034', '560038' ) as $postcode ) {\n    $zone->add_location( $postcode, 'postcode' );\n}\n$zone->save();\n"
    },
    {
      "step": "runPHP",
      "code": "<?php\nrequire '/wordpress/wp-load.php';\ndelete_option( 'bhaivatech_storefront_delivery_postcodes' );\n"
    }
  ]
}
