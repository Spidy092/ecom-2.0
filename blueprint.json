{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Grovia Modern Grocery Storefront Demo",
    "author": "BhaivaTech",
    "description": "One-click WordPress Playground starter environment with WooCommerce and Grovia storefront core plugin and block theme."
  },
  "landingPage": "/",
  "preferredVersions": {
    "php": "8.3",
    "wp": "7.1"
  },
  "extraLibraries": [
    "wp-cli"
  ],
  "features": {
    "networking": true
  },
  "steps": [
    {
      "step": "defineWpConfigConsts",
      "consts": {
        "WP_ENVIRONMENT_TYPE": "local"
      }
    },
    {
      "step": "login"
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "url",
        "url": "https://downloads.wordpress.org/plugin/woocommerce.11.0.1.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "url",
        "url": "https://github.com/Spidy092/ecom-2.0/releases/download/v0.0.3-alpha.33/bhaivatech-storefront-core-0.0.3-alpha.33.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "url",
        "url": "https://github.com/Spidy092/ecom-2.0/releases/download/v0.0.3-alpha.33/bhaivatech-grocery-alpha-0.0.3-alpha.33.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "Grovia Organic Groceries",
        "blogdescription": "Instant grocery ordering and postcode delivery",
        "woocommerce_store_address": "12 Kurla West",
        "woocommerce_store_city": "Mumbai",
        "woocommerce_default_country": "IN:MH",
        "woocommerce_currency": "INR"
      }
    },
    {
      "step": "wp-cli",
      "command": "wp grovia seed-demo"
    }
  ]
}
