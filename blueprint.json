{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Grovia Modern Grocery Storefront Demo",
    "author": "BhaivaTech",
    "description": "One-click WordPress Playground starter environment with WooCommerce and Grovia storefront core plugin and block theme."
  },
  "landingPage": "/",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "steps": [
    {
      "step": "login"
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "woocommerce"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/Spidy092/ecom-2.0/main/dist/bhaivatech-storefront-core-0.0.1-alpha.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/Spidy092/ecom-2.0/main/dist/bhaivatech-grocery-alpha-0.0.1-alpha.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "Grovia Organic Groceries",
        "blogdescription": "Instant grocery ordering and postcode delivery",
        "woocommerce_store_address": "12 Kurla West",
        "woocommerce_store_city": "Mumbai",
        "woocommerce_default_country": "IN:MH",
        "woocommerce_currency": "INR"
      }
    }
  ]
}
