{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "storefront-core/delivery-checker",
	"version": "1.0.0",
	"title": "Grocery Delivery Checker",
	"category": "widgets",
	"icon": "location-alt",
	"description": "Interactive postcode serviceability checker for shoppers.",
	"textdomain": "storefront-core",
	"supports": {
		"html": false,
		"align": ["wide", "full"],
		"interactivity": true
	},
	"attributes": {
		"heading": {
			"type": "string",
			"default": "Check Delivery Availability"
		},
		"placeholder": {
			"type": "string",
			"default": "Enter your postcode (e.g. 560001)"
		}
	},
	"render": "file:./render.php",
	"viewScriptModule": "file:./view.js"
}
