{
	"name": "bhaivatech/storefront-core",
	"description": "Internal core plugin for the grocery-first WooCommerce product.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.3"
	},
	"require-dev": {
		"phpunit/phpunit": "^11.0",
		"yoast/phpunit-polyfills": "^3.0",
		"brain/monkey": "^2.6",
		"mockery/mockery": "^1.6",
		"phpstan/phpstan": "^1.10",
		"szepeviktor/phpstan-wordpress": "^1.3",
		"php-stubs/woocommerce-stubs": "^8.0",
		"squizlabs/php_codesniffer": "^3.8",
		"wp-coding-standards/wpcs": "^3.0"
	},
	"autoload": {
		"psr-4": {
			"StorefrontCore\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"StorefrontCore\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit",
		"phpstan": "phpstan analyse -c phpstan.neon",
		"phpcs": "phpcs --standard=.phpcs.xml.dist src/ storefront-core.php",
		"make-pot": "wp i18n make-pot . languages/storefront-core.pot",
		"lint": ["@phpcs", "@phpstan"]
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
