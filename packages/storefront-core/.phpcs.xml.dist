<?xml version="1.0"?>
<ruleset name="GroviaCore">
	<description>PHPCodeSniffer ruleset for Grovia Core plugin.</description>

	<!-- Pass flags -->
	<arg value="ps"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>

	<!-- Exclude paths -->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>

	<!-- The Core rules preserve security and WordPress API checks. The legacy
	     PSR-4 classes in this package intentionally use their class-case file
	     names and short-array syntax, so the broader Extra/Docs presets are not
	     compatible with the existing public package structure. -->
	<rule ref="WordPress-Core">
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
	</rule>

	<!-- Specific Configs -->
	<config name="minimum_supported_wp_version" value="6.5"/>

	<!-- Naming convention overrides for PSR-4 compliance -->
	<rule ref="WordPress.Files.FileName">
		<properties>
			<property name="strict_class_file_names" value="false"/>
		</properties>
	</rule>

</ruleset>
