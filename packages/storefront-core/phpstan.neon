includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 6
    paths:
        - src
        - storefront-core.php
    excludePaths:
        - vendor
        - tests
    bootstrapFiles:
        - storefront-core.php
    scanFiles:
        - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
        - includes/class-buy-again-service.php
        - includes/class-storefront-frontend.php
        - includes/class-setup-wizard.php
        - includes/class-system-status.php
