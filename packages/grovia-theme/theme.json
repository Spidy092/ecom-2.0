{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1240px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "ink", "name": "Ink", "color": "#161A1D" },
        { "slug": "paper", "name": "Paper", "color": "#FFFDFC" },
        { "slug": "soft", "name": "Soft", "color": "#F5F3EE" },
        { "slug": "line", "name": "Line", "color": "#D9D6CF" },
        { "slug": "muted", "name": "Muted", "color": "#5E5A54" },
        { "slug": "accent", "name": "Accent", "color": "#C2410C" },
        { "slug": "success", "name": "Success", "color": "#176B45" },
        { "slug": "warning", "name": "Warning", "color": "#8A5300" }
      ]
    },
    "spacing": {
      "spacingSizes": [
        { "slug": "20", "name": "2XS", "size": "0.375rem" },
        { "slug": "30", "name": "XS", "size": "0.5rem" },
        { "slug": "40", "name": "S", "size": "0.75rem" },
        { "slug": "50", "name": "M", "size": "1rem" },
        { "slug": "60", "name": "L", "size": "1.5rem" },
        { "slug": "70", "name": "XL", "size": "2rem" },
        { "slug": "80", "name": "2XL", "size": "3rem" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "system",
          "name": "System Sans",
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "micro", "name": "Micro", "size": "0.75rem" },
        { "slug": "small", "name": "Small", "size": "0.875rem" },
        { "slug": "medium", "name": "Medium", "size": "1rem" },
        { "slug": "large", "name": "Large", "size": "clamp(1.25rem, 3vw, 1.55rem)" },
        { "slug": "x-large", "name": "Extra Large", "size": "clamp(1.9rem, 6vw, 3.2rem)" }
      ]
    },
    "custom": {
      "grovia": {
        "radius": {
          "control": "0.7rem",
          "surface": "0.8rem",
          "pill": "999px"
        },
        "shadow": {
          "floating": "0 0.8rem 2rem rgba(22, 26, 29, 0.18)"
        },
        "motion": {
          "fast": "120ms",
          "normal": "180ms"
        }
      }
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|paper",
      "text": "var:preset|color|ink"
    },
    "spacing": {
      "blockGap": "var:preset|spacing|50"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|system",
      "fontSize": "var:preset|font-size|medium",
      "lineHeight": "1.45"
    },
    "elements": {
      "button": {
        "border": { "radius": "0.7rem" },
        "color": {
          "background": "var:preset|color|accent",
          "text": "var:preset|color|paper"
        },
        "typography": { "fontWeight": "750" }
      },
      "link": {
        "color": { "text": "var:preset|color|ink" }
      },
      "heading": {
        "typography": {
          "fontWeight": "760",
          "lineHeight": "1.12"
        }
      }
    },
    "blocks": {
      "core/button": {
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "right": "1rem",
            "bottom": "0.75rem",
            "left": "1rem"
          }
        }
      },
      "core/site-title": {
        "typography": {
          "fontWeight": "800"
        }
      }
    }
  }
}
